# XcodeGen output — never committed, always regenerated
*.xcodeproj
*.xcworkspace

# Build products
build/
DerivedData/
.build/
*.ipa
*.xcarchive
Payload/

# SPM
.swiftpm/
Package.resolved

# macOS / editor cruft
.DS_Store
*.swp

# IDE
.idea/
.vscode/

# Keys and certificates — never committed. A blanket `git add -A` swept an
# SSH private key in here once; these patterns stop that recurring.
id_*
!id_*.md
*.pem
*.p12
*.key
*.mobileprovision
